{
  "id": null,
  "uid": "cvhome-logs-errors",
  "title": "Logs & Errors",
  "description": "What the services are saying: error volume per service, the most frequent error messages and exception classes, and a searchable log view where every line links to its trace.",
  "tags": [
    "cvhome",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "lsvc",
        "label": "Service",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "query": "label_values({service_name=~\".+\"}, service_name)",
          "refId": "var"
        },
        "definition": "label_values({service_name=~\".+\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Level",
        "query": "error|warn|info|debug,error,error|warn,info,debug",
        "options": [
          {
            "text": "error|warn|info|debug",
            "value": "error|warn|info|debug",
            "selected": true
          },
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "error|warn",
            "value": "error|warn",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ],
        "current": {
          "text": "error|warn|info|debug",
          "value": "error|warn|info|debug"
        },
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Contains",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Traces",
      "url": "/d/cvhome-traces?${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Service RED",
      "url": "/d/cvhome-service-red?${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines / s by level",
      "description": "Volume per level. A jump in error or warn is the first sign of trouble even before a metric moves.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (detected_level) (count_over_time({service_name=~\"$lsvc\"} | detected_level=~\"$level\" [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Error lines / s by service",
      "description": "Which service is producing the errors.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$lsvc\"} | detected_level=\"error\" [$__auto]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [],
      "id": 2
    },
    {
      "type": "table",
      "title": "Top error messages",
      "description": "The most frequent error messages (first 80 characters) in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (service_name, msg) (count_over_time({service_name=~\"$lsvc\"} | detected_level=\"error\" | regexp \"^(?P<msg>.{0,80})\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "links": [],
      "id": 3
    },
    {
      "type": "table",
      "title": "Exception classes",
      "description": "Exception class names found in error and warning lines, most frequent first.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (service_name, ex) (count_over_time({service_name=~\"$lsvc\"} | detected_level=~\"error|warn\" | regexp \"(?P<ex>[A-Za-z0-9_.$]+(Exception|Error))\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "links": [],
      "id": 4
    },
    {
      "type": "table",
      "title": "Error codes returned to callers",
      "description": "The error codes the @ControllerAdvice logged (\"CATALOG.PRODUCT.NOT_FOUND [traceId=…]\"), most frequent first.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (service_name, code) (count_over_time({service_name=~\"$lsvc\"} |~ \"\\\\[traceId=\" | regexp \"^(?P<code>[0-9]{3} [A-Z_]+|[A-Z][A-Z_.]+) \\\\[traceId=\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "links": [],
      "id": 5
    },
    {
      "type": "table",
      "title": "Remote and provider failures",
      "description": "Calls to a peer service (RemoteServiceException) or a third party (ExternalProviderException) that failed.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, ex) (count_over_time({service_name=~\"$lsvc\"} | regexp \"(?P<ex>RemoteServiceException|ExternalProviderException|[A-Za-z]+ApiUnavailableException)\" [$__range]))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "links": [],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Observation scope-leak warnings",
      "description": "Count of the \"Observation … is not the same as the one set as this scope's parent\" warning. It must be zero; it was firing on every scheduled refresh of the gateway before the fix.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\".+\"} |= \"ObservationThreadLocalAccessor\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      },
      "links": [],
      "id": 7
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "The log view. Filter by service, level and free text; expand a line and click \"View trace\" to open its trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$lsvc\"} | detected_level=~\"$level\" |~ \"$search\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "links": [],
      "id": 8
    }
  ]
}
