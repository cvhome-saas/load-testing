{
  "id": null,
  "uid": "cvhome-traces",
  "title": "Traces",
  "description": "Ready-made trace searches: the slowest requests, the failed ones, the failed service-to-service calls, the slow SQL. Each row opens the full trace, with its log lines one click away.",
  "tags": [
    "cvhome",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "tsvc",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_calls_total, service_name)",
          "refId": "var"
        },
        "definition": "label_values(traces_span_metrics_calls_total, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Logs & Errors",
      "url": "/d/cvhome-logs-errors?${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Service-to-Service",
      "url": "/d/cvhome-service-to-service?${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Slow requests (> 500 ms)",
      "description": "Server spans slower than the storefront SLO, slowest first.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=server && duration > 500ms}",
          "limit": 30,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 1
    },
    {
      "type": "table",
      "title": "Failed requests",
      "description": "Server spans that ended in error.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=server && status=error}",
          "limit": 30,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 2
    },
    {
      "type": "table",
      "title": "5xx responses",
      "description": "Requests answered with a server error.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=server && span.http.response.status_code >= 500}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 3
    },
    {
      "type": "table",
      "title": "403 and 404 responses",
      "description": "Requests refused for permission or an unknown resource.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=server && (span.http.response.status_code = 403 || span.http.response.status_code = 404)}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 4
    },
    {
      "type": "table",
      "title": "Failed service-to-service calls",
      "description": "Client spans (one service calling another) that failed, with the destination.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=client && status=error && span.db.system = nil}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 5
    },
    {
      "type": "table",
      "title": "Slow SQL (> 100 ms)",
      "description": "Individual statements slower than 100 ms.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span.db.system=\"postgresql\" && duration > 100ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 6
    },
    {
      "type": "table",
      "title": "Statement-heavy requests",
      "description": "Traces with more than 20 statements: N+1 candidates.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span.db.system=\"postgresql\"} | count() > 20",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 7
    },
    {
      "type": "table",
      "title": "Failed background work",
      "description": "Scheduled and internal work (outbox handlers, jobs) that failed.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$tsvc\" && span:kind=internal && status=error}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm"
      },
      "links": [],
      "id": 8
    },
    {
      "type": "table",
      "title": "Busiest server spans",
      "description": "Span names by rate with their error share, from the span metrics. Click a name to search its traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(25, sum by (service_name, span_name) (rate(traces_span_metrics_calls_total{service_name=~\"$tsvc\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, span_name) (rate(traces_span_metrics_calls_total{service_name=~\"$tsvc\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service_name, span_name) (rate(traces_span_metrics_calls_total{service_name=~\"$tsvc\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.001
                    },
                    {
                      "color": "red",
                      "value": 0.01
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Search these spans",
                    "targetBlank": true,
                    "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22${__data.fields.service_name}%5C%22%20%26%26%20name%3D%5C%22${__data.fields.span_name}%5C%22%7D%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "calls/s",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "showHeader": true
      },
      "links": [],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Time 1": true,
              "Value #A": false,
              "Time 2": true,
              "Value #B": false
            },
            "renameByName": {
              "Value #A": "calls/s",
              "Value #B": "error share"
            }
          }
        }
      ],
      "id": 9
    }
  ]
}
