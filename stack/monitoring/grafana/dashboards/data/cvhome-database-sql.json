      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(hikaricp_connections_timeout_total{service_name=~\"$service\"}[$__range]))",
          "legendFormat": "",
