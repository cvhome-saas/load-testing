{
  "id": null,
  "uid": "cvhome-database-sql",
  "title": "Database & SQL",
  "description": "The database side of every service: the connection pool, how many statements each request costs, and how slow each statement family is. Built from Hikari meters and the JDBC client spans.",
  "tags": [
    "cvhome",
    "data"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, service_name)",
          "refId": "var"
        },
        "definition": "label_values(http_server_requests_seconds_count, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Bottlenecks",
      "url": "/d/cvhome-bottlenecks?var-service=$service&${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Traces",
      "url": "/d/cvhome-traces?${__url_time_range}",
      "type": "link",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Connection pool",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Pool: active / idle / pending / max",
      "description": "Connections in use, spare, threads waiting, and the ceiling. Pending above zero is exhaustion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name) (hikaricp_connections_active{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name) (hikaricp_connections_idle{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} idle"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name) (hikaricp_connections_pending{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} pending"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_name) (hikaricp_connections_max{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [],
      "id": 2
    },
    {
      "type": "gauge",
      "title": "Pool utilisation",
      "description": "Connections in use as a share of the pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cvhome:hikari_pool:utilisation{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "links": [],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Connection timeouts",
      "description": "Requests that gave up waiting for a connection in the selected range. Must be zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
