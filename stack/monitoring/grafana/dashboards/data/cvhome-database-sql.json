        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Time 1": true,
              "Value #A": false,
              "Time 2": true,
              "Value #B": false,
              "Time 3": true,
              "Value #C": false
            },
            "renameByName": {
              "Value #A": "calls/s",
              "Value #B": "p95 (s)",
              "Value #C": "errors/s"
            }
          }
        }
      ],
      "id": 12
    },
    {
      "type": "table",
      "title": "N+1 suspects",
      "description": "Requests that ran more than 20 statements in one trace.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && span.db.system=\"postgresql\"} | count() > 20",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
