{
  "id": null,
  "uid": "cvhome-bottlenecks",
  "title": "Bottlenecks",
  "description": "Where is the system saturating? Every resource that can run out — request threads, database connections, CPU, GC, executor queues, caches — as a share of its limit, next to traffic and latency, so the first one to hit its ceiling under load is obvious.",
  "tags": [
    "cvhome",
    "platform"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
