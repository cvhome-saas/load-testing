{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.mjs\"", "timeout": 5, "statusMessage": "Checking worktree" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-guard.mjs\"", "timeout": 5, "statusMessage": "Checking design record" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.mjs\"", "timeout": 15, "statusMessage": "Checking the push receipt" }
        ]
      }
    ]
  }
}
